{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bevel fmt --hook",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bevel status --brief",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bevel pending",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(bevel approve*)"
    ]
  }
}
